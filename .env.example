# Application
PORT=13000
NODE_ENV=development

# PostgreSQL (host port mapped by docker compose; must stay high/non-default)
DATABASE_URL=postgresql://jungle:jungle_local@127.0.0.1:15432/jungle

# LocalStack SQS
SQS_ENDPOINT=http://127.0.0.1:14566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_WAGER=wager-transactions.fifo
SQS_QUEUE_DLQ=wager-transactions-dlq.fifo
SQS_QUEUE_EVENTS=wager-events.fifo

# SQS consumer
CONSUMER_ENABLED=true
SQS_CONSUMER_WAIT_SECONDS=20
SQS_CONSUMER_MAX_MESSAGES=10
SQS_CONSUMER_IDLE_BACKOFF_MS=1000
SQS_VISIBILITY_TIMEOUT=5
SQS_MAX_RECEIVE_COUNT=5

# Outbox publisher
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
OUTBOX_BASE_DELAY_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000

# Reference resolution
REFERENCE_WORKER_ENABLED=true
REFERENCE_POLL_INTERVAL_MS=500
REFERENCE_BATCH_SIZE=100
REFERENCE_BASE_DELAY_MS=5000
REFERENCE_BACKOFF_FACTOR=2
REFERENCE_MAX_ATTEMPTS=8
REFERENCE_TTL_MS=900000

# Reconciliation
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_BATCH_SIZE=500

# Logging
LOG_LEVEL=info
