{
  "name": "jungle-wagering",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Wagering Processor - iGaming financial service",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run scripts/migrate.ts up",
    "migrate:down": "bun run scripts/migrate.ts down",
    "migrate:down:all": "bun run scripts/migrate.ts down-all",
    "sqs:bootstrap": "bun run scripts/bootstrap-queues.ts",
    "test:setup": "bun run scripts/test-setup.ts",
    "test:unit": "bun test --preload ./test/preload.ts test/unit",
    "test:integration": "bun run scripts/test-setup.ts && bun test --preload ./test/preload.ts test/integration",
    "test:concurrency": "bun run scripts/test-setup.ts && bun test --preload ./test/preload.ts test/concurrency",
    "test": "bun run scripts/test-setup.ts && bun test --preload ./test/preload.ts",
    "compose:up": "docker compose -p jungle_wagering up -d",
    "compose:down": "docker compose -p jungle_wagering down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/postgresql": "^6.4.16",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "decimal.js": "^10.4.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "bun-types": "latest",
    "typescript": "^5.7.2"
  }
}
